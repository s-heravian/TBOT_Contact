TELEGRAM_TOKEN=your_bot_token_here

# Domains
WEBHOOK_DOMAIN=https://bot.yourdomain.com
API_DOMAIN=https://api.yourdomain.com

# Database Configuration
DB_HOST=db
DB_DATABASE=tbot
DB_USERNAME=tbot_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# Security
# FORCE_CAPTCHA: If true, forces all sites to configure Cloudflare Turnstile during registration.
FORCE_CAPTCHA=false
